# Copie ce fichier en ".env" et remplis tes vraies valeurs

# Port du serveur
PORT=5000

# Connexion MongoDB (MongoDB Atlas ou local)
MONGO_URI=mongodb://127.0.0.1:27017/jmd_transport

# Secret pour signer les tokens JWT (mets une longue chaîne aléatoire en production)
JWT_SECRET=change_this_secret_key_in_production
JWT_EXPIRES_IN=7d

# URL du frontend (pour CORS)
CLIENT_URL=http://localhost:5173

# Orange Money (à activer plus tard)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=

# Wave (à activer plus tard)
WAVE_API_KEY=
